# Copy to .env and fill in. Never commit real keys: .env is git-ignored.

# --- Core ---------------------------------------------------------------
# Public URL of the site, used in emails, payment callbacks, sitemap and social previews.
APP_URL=http://localhost:3000
# Folder for the databases: control.db (accounts, billing) and tenants/<id>.db (one per business).
DATA_DIR=./data
# "true" once the site is served over HTTPS, so the session cookie is marked Secure.
COOKIE_SECURE=false
# Session lifetime in days.
SESSION_DAYS=14

# --- Plan ---------------------------------------------------------------
# Free trial length for new accounts (0 = pay before using).
TRIAL_DAYS=14
# Monthly price charged through bKash, in taka. Card price is US$5 (or STRIPE_PRICE_ID).
BKASH_PRICE_BDT=600

# --- Public details -----------------------------------------------------
SUPPORT_EMAIL=support@example.com
# Legal name shown in the Terms and Privacy Policy.
LEGAL_ENTITY_NAME=BizFlow

# --- Email (password resets) --------------------------------------------
# Any SMTP provider, e.g. smtps://user:pass@smtp.example.com:465
# Without it, emails are printed to the server log (fine for development only).
SMTP_URL=
MAIL_FROM=BizFlow <no-reply@example.com>

# --- Stripe (cards) -----------------------------------------------------
# Test keys start with sk_test_ / whsec_. See docs/BILLING.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a recurring US$5/month Price from the Stripe dashboard. Without it an inline price is used.
STRIPE_PRICE_ID=

# --- bKash (Tokenized Checkout) -----------------------------------------
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta   Live: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
